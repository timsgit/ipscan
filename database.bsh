#!/bin/bash
#
#    IPscan - an HTTP-initiated IPv6 port scanner.
#
#    (C) Copyright 2011-2026 Tim Chappell.
#
#    This file is part of IPscan.
#
#    IPscan is free software: you can redistribute it and/or modify
#    it under the terms of the GNU General Public License as published by
#    the Free Software Foundation, either version 3 of the License, or
#    (at your option) any later version.
#
#    This program is distributed in the hope that it will be useful,
#    but WITHOUT ANY WARRANTY; without even the implied warranty of
#    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
#    GNU General Public License for more details.
#
#    You should have received a copy of the GNU General Public License
#    along with IPscan.  If not, see <http://www.gnu.org/licenses/>.
#
# database.bsh
# version      	description
# 0.01          initial version
# 0.02          clean up exit traps, remove unused code
# 0.03          ensure consistency with SQL quoting

set -euo pipefail
umask 077
SRC="./ipscan.h"
SCHEMA="./schema.sql"

usage()
{
    echo "Usage: $0 --create-database | --install-schema | --upgrade | --purge-database" >&2
    exit 2
}

sql_quote()
{
    local value=$1
    value=${value//\'/\'\'}
    printf "'%s'" "$value"
}

[[ $# -eq 1 ]] || usage
MODE="$1"

case "$MODE" in
    --create-database|--install-schema|--upgrade|--purge-database) ;;
    *) usage ;;
esac

if [[ ! -r "$SRC" ]]; then
	echo "ERROR: Cannot read $SRC" >&2
	exit 1
fi

read_define()
{
	local name="$1"
	awk -v key="$name" 'BEGIN{found=0};$1 == "#define" && $2 == key {value=$3;gsub(/"/, "", value);found=1};END{if (found){print value} else {exit 1}}' "$SRC"
}

prompt_admin()
{
    local admin_password

    read -r -p "MySQL administrator username: " ADMIN_USER

    [[ -n "$ADMIN_USER" ]] || {
        echo "ERROR: Administrator username is required" >&2
        return 1
    }

    read -r -s -p "MySQL administrator password: " admin_password
    printf '\n' >&2

    ADMIN_CNF=$(mktemp) || return 1
    chmod 600 "$ADMIN_CNF"

    # Escape characters that have special meaning in MySQL option files.
    local escaped_password=${admin_password//\\/\\\\}
    escaped_password=${escaped_password//\"/\\\"}

    if ! {
        printf '[client]\n'
        printf 'host="%s"\n' "$MYSQL_HOST"
        printf 'user="%s"\n' "$ADMIN_USER"
        printf 'password="%s"\n' "$escaped_password"
    } > "$ADMIN_CNF"; then
        rm -f "$ADMIN_CNF"
        unset admin_password escaped_password
        return 1
    fi

    unset admin_password escaped_password

    ADMIN_MYSQL_CMD=(
        mysql
        --defaults-extra-file="$ADMIN_CNF"
        --batch
        --show-warnings
    )
}

cleanup_admin()
{
    if [[ -n "${ADMIN_CNF:-}" ]]; then
        rm -f -- "$ADMIN_CNF"
    fi
    if [[ -n "${TMPFILE:-}" ]]; then
        rm -f -- "$TMPFILE"
    fi
}

# register handler to remove stored credentials
# and temporary file
trap cleanup_admin EXIT

create_database()
{
    echo "Creating database $MYSQL_DBNAME."

    prompt_admin || return 1

    "${ADMIN_MYSQL_CMD[@]}" --execute="
SET SESSION sql_mode = CONCAT_WS(',', NULLIF(@@SESSION.sql_mode, ''), 'NO_BACKSLASH_ESCAPES');
CREATE DATABASE IF NOT EXISTS \`$MYSQL_DBNAME\`;
    " || {
        echo "ERROR: Create Database failed." >&2
        return 1
    }

    echo "Database provisioning completed."
}

purge_database()
{
    prompt_admin || return 1

    printf '\n'
    printf 'WARNING: DESTRUCTIVE DATABASE PURGE\n\n'
    printf 'Database:       %s\n' "$MYSQL_DBNAME"
    printf 'Results table:  %s\n' "$MYSQL_TBLNAME"
    printf 'Runtime account: %s@%s\n\n' \
        "$MYSQL_USER" "$MYSQL_USER_HOST"

    echo "This operation will:"
    echo "  - Permanently delete the entire database and all its tables."
    echo "  - Delete the dedicated runtime MySQL account."
    echo "  - Permanently remove all stored scan results and other data."
    printf '\n'

    read -r -p "Type PURGE to confirm: " answer

    [[ "$answer" == "PURGE" ]] || {
        echo "Database purge cancelled."
        return 1
    }

    echo "Purging database and runtime account..."

    "${ADMIN_MYSQL_CMD[@]}" --execute="
        SET SESSION sql_mode = CONCAT_WS(',', NULLIF(@@SESSION.sql_mode, ''), 'NO_BACKSLASH_ESCAPES');
        DROP DATABASE IF EXISTS \`${MYSQL_DBNAME}\`;
        DROP USER IF EXISTS $(sql_quote "$MYSQL_USER")@$(sql_quote "$MYSQL_USER_HOST");
    " || {
        echo "ERROR: Database purge failed." >&2
        return 1
    }

    echo "Database and runtime account purged."
}

install_schema()
{
    [[ -r "$SCHEMA" ]] || {
        echo "ERROR: Cannot read schema file: $SCHEMA" >&2
        exit 1
    }

    echo "Installing Schema and GRANTing minimal privileges to the "$MYSQL_TBLNAME" table."
    prompt_admin || exit 1

    TMPFILE=$(mktemp) || exit 1

    echo "SET SESSION sql_mode = CONCAT_WS(',', NULLIF(@@SESSION.sql_mode, ''), 'NO_BACKSLASH_ESCAPES');" > "$TMPFILE"

    # Substitute the validated configured table name.
    sed "s/\`results\`/\`$MYSQL_TBLNAME\`/g" "$SCHEMA" >> "$TMPFILE" ||
        exit 1

    # Run schema creation first.
    "${ADMIN_MYSQL_CMD[@]}" \
        --database="$MYSQL_DBNAME" < "$TMPFILE" || {
        echo "ERROR: Schema creation failed." >&2
        exit 1
    }

    # Check whether the runtime account exists before dropping it.
    if "${ADMIN_MYSQL_CMD[@]}" --skip-column-names --execute="
        SET SESSION sql_mode = CONCAT_WS(',', NULLIF(@@SESSION.sql_mode, ''), 'NO_BACKSLASH_ESCAPES');
        SELECT COUNT(*) FROM mysql.user WHERE User = $(sql_quote "$MYSQL_USER") AND Host = $(sql_quote "$MYSQL_USER_HOST");
    " | grep -qx '1'; then
        "${ADMIN_MYSQL_CMD[@]}" --execute="
            SET SESSION sql_mode = CONCAT_WS(',', NULLIF(@@SESSION.sql_mode, ''), 'NO_BACKSLASH_ESCAPES');
            DROP USER $(sql_quote "$MYSQL_USER")@$(sql_quote "$MYSQL_USER_HOST");
        " || {
            echo "ERROR: Could not drop existing runtime account." >&2
            exit 1
        }
    fi

    # Create the runtime account and grant table-only privileges.
    "${ADMIN_MYSQL_CMD[@]}" --execute="
        SET SESSION sql_mode = CONCAT_WS(',', NULLIF(@@SESSION.sql_mode, ''), 'NO_BACKSLASH_ESCAPES');
        CREATE USER $(sql_quote "$MYSQL_USER")@$(sql_quote "$MYSQL_USER_HOST") IDENTIFIED BY $(sql_quote "$MYSQL_PASSWD");
        GRANT SELECT, INSERT, UPDATE, DELETE ON \`${MYSQL_DBNAME}\`.\`${MYSQL_TBLNAME}\` TO $(sql_quote "$MYSQL_USER")@$(sql_quote "$MYSQL_USER_HOST");
    " || {
        echo "ERROR: Runtime account creation or privilege grant failed." >&2
        exit 1
    }

    echo "Schema installed; runtime privileges restricted to the results table."
}

upgrade()
{
    echo "Attempting upgrade - DROP TABLE ${MYSQL_TBLNAME} and USER ${MYSQL_USER}@${MYSQL_USER_HOST}, if they exist."
    prompt_admin || exit 1

    printf 'Database: %s\nTable: %s\nRuntime account: %s@%s\n' \
        "$MYSQL_DBNAME" "$MYSQL_TBLNAME" \
        "$MYSQL_USER" "$MYSQL_USER_HOST"

    read -r -p "This deletes the results table and runtime account. Continue? [y/N] " answer
    [[ "$answer" == [yY] ]] || {
        echo "Upgrade cancelled."
        exit 1
    }

    "${ADMIN_MYSQL_CMD[@]}" --execute="
        SET SESSION sql_mode = CONCAT_WS(',', NULLIF(@@SESSION.sql_mode, ''), 'NO_BACKSLASH_ESCAPES');
        DROP TABLE IF EXISTS \`${MYSQL_DBNAME}\`.\`${MYSQL_TBLNAME}\`;
        DROP USER IF EXISTS $(sql_quote "$MYSQL_USER")@$(sql_quote "$MYSQL_USER_HOST");
    " || {  
        echo "ERROR: Upgrade failed." >&2
        exit 1
    }

    echo "Upgrade cleanup completed."
}

# Parse the ipscan.h file where the MYSQL_ variables are defined
# this is the host the database server runs on
MYSQL_HOST=$(read_define MYSQL_HOST)
MYSQL_USER=$(read_define MYSQL_USER)
# this is the user's host, used for account creation and grants,
MYSQL_USER_HOST=$(read_define MYSQL_USER_HOST)
MYSQL_PASSWD=$(read_define MYSQL_PASSWD)
MYSQL_DBNAME=$(read_define MYSQL_DBNAME)
MYSQL_TBLNAME=$(read_define MYSQL_TBLNAME)

# Check identifiers before passing them onto MySQL.
[[ "$MYSQL_DBNAME" =~ ^[A-Za-z0-9_]+$ ]] || {
    echo "ERROR: Invalid database name" >&2
    exit 1
}
[[ "$MYSQL_TBLNAME" =~ ^[A-Za-z0-9_]+$ ]] || {
    echo "ERROR: Invalid table name" >&2
    exit 1
}

case "$MODE" in
    --create-database)
        create_database
	;;

    --install-schema)
        install_schema
        ;;

    --upgrade)
	upgrade
        ;;

    --purge-database)
        purge_database || exit 1
        ;;

esac

echo Done.
